{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/resume/Mark-Julius-Mella-Resume.pdf",
      "destination": "/resume/Mark-Julius-M-Resume.pdf",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/about", "destination": "/about/", "permanent": true },
    { "source": "/about/index.html", "destination": "/about/", "permanent": true },
    { "source": "/contact", "destination": "/contact/", "permanent": true },
    { "source": "/contact/index.html", "destination": "/contact/", "permanent": true },
    { "source": "/resume", "destination": "/resume/", "permanent": true },
    { "source": "/resume/index.html", "destination": "/resume/", "permanent": true },
    {
      "source": "/projects/design-token-system",
      "destination": "/projects/wallet-payment-journeys",
      "permanent": true
    },
    {
      "source": "/projects/design-token-system/",
      "destination": "/projects/wallet-payment-journeys",
      "permanent": true
    },
    {
      "source": "/projects/design-token-system/index.html",
      "destination": "/projects/wallet-payment-journeys",
      "permanent": true
    },
    {
      "source": "/projects/wallet-payment-journeys/",
      "destination": "/projects/wallet-payment-journeys",
      "permanent": true
    },
    {
      "source": "/projects/wallet-payment-journeys/index.html",
      "destination": "/projects/wallet-payment-journeys",
      "permanent": true
    },
    {
      "source": "/projects/retail-betting-application/",
      "destination": "/projects/retail-betting-application",
      "permanent": true
    },
    {
      "source": "/projects/retail-betting-application/index.html",
      "destination": "/projects/retail-betting-application",
      "permanent": true
    },
    {
      "source": "/projects/frontend-performance/",
      "destination": "/projects/frontend-performance",
      "permanent": true
    },
    {
      "source": "/projects/frontend-performance/index.html",
      "destination": "/projects/frontend-performance",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/resume/Mark-Julius-M-Resume.pdf",
      "headers": [
        {
          "key": "Link",
          "value": "<https://markjulius.vercel.app/resume/>; rel=\"canonical\""
        }
      ]
    }
  ]
}
