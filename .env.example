# Public build settings. Copy to .env.production.local or set on your host.
# Use your real HTTPS domain or hosting URL at the domain root (no subpath).
# Public builds default to the confirmed URL in src/data/profile.ts.
# Set this only to override that address; leave empty for a noindex review build.
VITE_SITE_URL=https://markjulius.vercel.app

# Optional: only the content value from Google Search Console's HTML meta tag.
# Leave empty if using DNS verification. This value is public, not a secret.
VITE_GOOGLE_SITE_VERIFICATION=
